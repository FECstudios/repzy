<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
        Yemek fotoğrafları cache'e yazılır: analiz sonrası saklanmasına gerek yok,
        sistem yer açması gerektiğinde kendisi siliyor.
    -->
    <cache-path
        name="meal_photos"
        path="meal_photos/" />

    <!--
        Vücut fotoğrafı da cache'e yazılıyor: kalıcı kopya Storage'da duruyor,
        cihazda ikinci bir kopya bırakmak veri minimizasyonuna aykırı olurdu.
    -->
    <cache-path
        name="body_photos"
        path="body_photos/" />
</paths>
