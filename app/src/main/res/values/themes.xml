<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose çizmeye başlayana kadar görünen tema. Renkler Compose tarafındaki
         Color.kt ile eşleşir; ekran açılışında renk zıplamasını önler. -->
    <style name="Theme.Repzy.Starting" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>
</resources>
